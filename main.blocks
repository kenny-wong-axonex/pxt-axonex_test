<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="(^0iZWGu|TcwWLd[,FGD" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="VTIVPo.:WGgU,c#{ZJs`"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum ApiCommand {" line1="    //% block=&quot;Get Status&quot;" line2="    GetStatus," line3="    //% block=&quot;Set Sensor Mode&quot;" line4="    SetSensorMode," line5="    //% block=&quot;Reset Board&quot;" line6="    ResetBoard" line7="}" numlines="8"></mutation><next><block type="typescript_statement" id="iOKA:_x$?rQ{oZ:0eQd/"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace R300ApiTx {" line1="    for (let i = 0; i &lt; 5; i++) {" line2="        serial.writeLine(&quot;test123&quot;);" line3="        " line4="        led.toggle(0, 0)" line5="        basic.pause(500)" line6="    }" line7="" line8="    let pendingReqId = -1;" line9="    let ackReceived = false;" line10="    let listenerInitialized = false;" line11="" line12="    /**" line13="     * Initializes the UART listener to process incoming ACK packets." line14="     * Expected ACK format: {&quot;ack&quot;: timestamp, &quot;status&quot;: &quot;ok&quot;}" line15="     */" line16="    function initAckListener() {" line17="        if (listenerInitialized) return;" line18="        listenerInitialized = true;" line19="" line20="        serial.onDataReceived(serial.delimiters(Delimiters.NewLine), () =&gt; {" line21="            let line = serial.readLine();" line22="            try {" line23="                let msg = JSON.parse(line);" line24="                if (msg &amp;&amp; msg.ack === pendingReqId) {" line25="                    ackReceived = true;" line26="                }" line27="            } catch (e) {" line28="                // Ignore malformed or non-JSON serial input" line29="            }" line30="        });" line31="    }" line32="" line33="    /**" line34="     * Calculates a simple 16-bit Fletcher checksum for a string." line35="     */" line36="    function calculateChecksum(data: string): number {" line37="        let sum1 = 0;" line38="        let sum2 = 0;" line39="        for (let j = 0; j &lt; data.length; j++) {" line40="            sum1 = (sum1 + data.charCodeAt(j)) % 255;" line41="            sum2 = (sum2 + sum1) % 255;" line42="        }" line43="        return (sum2 &lt;&lt; 8) | sum1;" line44="    }" line45="" line46="    /**" line47="     * Send standardized API payload over UART with ACK wait &amp; retry logic." line48="     * Shows LED status indicators on success (Checkmark) or failure (X for 5s)." line49="     * @param cmd API Command to execute" line50="     * @param maxRetries Maximum retry attempts (default 3)" line51="     * @param timeoutMs Timeout in ms per attempt (default 500ms)" line52="     */" line53="    //% block=&quot;send API command %cmd over UART&quot;" line54="    //% cmd.fieldEditor=&quot;gridpicker&quot;" line55="    //% cmd.fieldOptions.columns=3" line56="    export function sendApiPayload(cmd: ApiCommand, maxRetries: number = 3, timeoutMs: number = 500): void {" line57="        initAckListener();" line58="" line59="        let actionStr = &quot;&quot;;" line60="        let actionData: any = {};" line61="        let ts = input.runningTime(); // Timestamp serves as the unique request ID" line62="" line63="        switch (cmd) {" line64="            case ApiCommand.GetStatus:" line65="                actionStr = &quot;getStatus&quot;;" line66="                actionData = { reqId: ts };" line67="                break;" line68="            case ApiCommand.SetSensorMode:" line69="                actionStr = &quot;setMode&quot;;" line70="                actionData = { reqId: ts, mode: &quot;active&quot;, rate: 500 };" line71="                break;" line72="            case ApiCommand.ResetBoard:" line73="                actionStr = &quot;reset&quot;;" line74="                actionData = { reqId: ts, hard: true };" line75="                break;" line76="        }" line77="" line78="        let payload = {" line79="            ts: ts," line80="            action: actionStr," line81="            data: actionData" line82="        };" line83="" line84="        let jsonString = JSON.stringify(payload);" line85="        let chk = calculateChecksum(jsonString);" line86="" line87="        let framedMessage = JSON.stringify({" line88="            raw: jsonString," line89="            chk: chk" line90="        });" line91="" line92="        // Retry loop" line93="        for (let attempt = 0; attempt &lt; maxRetries; attempt++) {" line94="            pendingReqId = ts;" line95="            ackReceived = false;" line96="" line97="            serial.writeLine(framedMessage);" line98="" line99="            // Wait for ACK or timeout" line100="            let startTime = input.runningTime();" line101="            while (input.runningTime() - startTime &lt; timeoutMs) {" line102="                if (ackReceived) {" line103="                    pendingReqId = -1;" line104="" line105="                    // Debug Visual: Brief checkmark for success" line106="                    basic.showIcon(IconNames.Yes);" line107="                    basic.pause(300);" line108="                    basic.clearScreen();" line109="" line110="                    return;" line111="                }" line112="                basic.pause(20); // Yield to MakeCode event queue" line113="            }" line114="        }" line115="" line116="        // Execution failed after all retry attempts" line117="        pendingReqId = -1;" line118="" line119="        // Debug Visual: Show 'X' for 5 seconds on failure" line120="        basic.showIcon(IconNames.No);" line121="        basic.pause(5000);" line122="        basic.clearScreen();" line123="" line124="        // return false;" line125="    }" line126="}" numlines="127"></mutation><next><block type="typescript_statement" id="(6co}epr)gCD3S#DGr!t"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace r300 {" line1="    let listenerRegistered = false" line2="" line3="    export class R300Link {" line4="        constructor() {" line5="            // tx=P0 -&gt; R300 GPIO21 (rx), rx=P1 &lt;- R300 GPIO10 (tx)." line6="            // Hold Button A while resetting to skip the redirect and stay on" line7="            // USB serial instead, for debugging without a firmware reflash." line8="            if (!input.buttonIsPressed(Button.A)) {" line9="                serial.redirect(SerialPin.P0, SerialPin.P1, BaudRate.BaudRate115200)" line10="            }" line11="" line12="            // Register only once — creating more than one R300Link must not" line13="            // stack duplicate serial.onDataReceived handlers." line14="            if (!listenerRegistered) {" line15="                listenerRegistered = true" line16="                serial.onDataReceived(serial.delimiters(Delimiters.NewLine), function () {" line17="                    const line2 = serial.readLine()" line18="                    // Only answer R300's own ping — never its ack, or both" line19="                    // sides would ping-pong each other until the link saturates." line20="                    if (line2.indexOf(&quot;R300_ping&quot;) &gt;= 0) {" line21="                        serial.writeString(JSON.stringify({ MicroBit_alive: &quot;yes&quot; }) + &quot;\n&quot;)" line22="                    }" line23="                })" line24="            }" line25="        }" line26="" line27="        /**" line28="         * Send a text message to R300, wrapped as JSON with a checksum." line29="         */" line30="        //% blockId=r300_send_message" line31="        //% block=&quot;%this|send message %text to R300&quot;" line32="        //% weight=90" line33="        sendMessage(text: string): void {" line34="            serial.writeString(JSON.stringify({ MicroBit: text, checksum: this.checksum(text) }) + &quot;\n&quot;)" line35="        }" line36="" line37="        private checksum(text: string): number {" line38="            // Sum of char codes mod 256 — matches R300's Checksum256() for" line39="            // ASCII text (aimo_v1_edu_microbit_board.cc)." line40="            let sum = 0" line41="            for (let k = 0; k &lt; text.length; k++) {" line42="                sum += text.charCodeAt(k)" line43="            }" line44="            return sum % 256" line45="        }" line46="    }" line47="" line48="    /**" line49="     * Connect to R300 over the P0/P1 UART link and start automatically" line50="     * answering its keep-alive pings." line51="     */" line52="    //% blockId=r300_connect" line53="    //% block=&quot;connect to R300&quot;" line54="    //% weight=100" line55="    //% blockSetVariable=r300Link" line56="    export function connect(): R300Link {" line57="        return new R300Link()" line58="    }" line59="}" numlines="60"></mutation></block></next></block></next></block></statement></block></xml>