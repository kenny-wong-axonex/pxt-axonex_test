<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="`cl2J~~{_Tv9j#kqp,g/">i</variable><variable id="|$u?;v:K?$?a}RExyBH[">sum</variable></variables><block type="pxt-on-start" id="H1!iBseOX8#X@U@bLTza" x="0" y="0"><statement name="HANDLER"><block type="device_pause" id="h?uEm6!FPNnFOz4LtbF?"><comment pinned="false" h="80" w="160">── Boot log ────────────────────────────────────────────────
等 USB CDC ready 先 print，避免開機頭幾個字被食</comment><value name="pause"><shadow type="timePicker" id="VrquTfFFrdXh(O7C@p3["><field name="ms">300</field></shadow></value><next><block type="serial_writeline" id="8tO+q.l^O}8K~m^p2;gD"><value name="text"><shadow type="text" id="Gc-H@pBTPQX-rI33aofm"><field name="TEXT">Hello World!</field></shadow></value><next><block type="typescript_statement" id="xjI}R3Zg0#/Fz[q![Nl!"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace r300 {" line1="    export class R300Link {" line2="        private latestAck: string = &quot;&quot;;" line3="        private ackReceived: boolean = false;" line4="        private ackSuccess: boolean = false;" line5="        private expectedAckDevice: string = &quot;&quot;;" line6="        private latestFinish: string = &quot;&quot;;" line7="        private latestStatus: string = &quot;&quot;;" line8="        private latestLeftHand: string = &quot;&quot;;" line9="        private latestRightHand: string = &quot;&quot;;" line10="        private latestEmotion: string = &quot;&quot;;" line11="        private latestVolume: string = &quot;&quot;;" line12="        private listenerRegistered: boolean = false;" line13="" line14="        constructor() {" line15="        }" line16="" line17="        private ensureInitialized(): void {" line18="            if (this.listenerRegistered) {" line19="                return;" line20="            }" line21="" line22="            if (!input.buttonIsPressed(Button.A)) {" line23="                serial.redirect(SerialPin.P0, SerialPin.P1, BaudRate.BaudRate115200);" line24="            }" line25="" line26="            this.listenerRegistered = true;" line27="            serial.onDataReceived(serial.delimiters(Delimiters.NewLine), () =&gt; {" line28="                const line = serial.readLine().trim();" line29="                console.log(&quot;[RX] &quot; + line);   // ← 收到嘅嘢都印去 USB log" line30="                if (line.includes(&quot;_ack&quot;)) {" line31="                    if (this.expectedAckDevice != &quot;&quot; &amp;&amp; line.includes(this.expectedAckDevice)) {" line32="                        this.latestAck = line;" line33="                        this.ackReceived = true;" line34="                        this.ackSuccess = line.includes(&quot;success&quot;);" line35="                    }" line36="                } else if (line.includes(&quot;_finish&quot;)) {" line37="                    this.latestFinish = line;" line38="                } else {" line39="                    try {" line40="                        const parsed = JSON.parse(line);" line41="                        if (parsed.cmd === &quot;system_status&quot; &amp;&amp; parsed.status !== undefined) {" line42="                            this.latestStatus = &quot;&quot; + parsed.status;" line43="                        } else if (parsed.cmd === &quot;servo_status&quot;) {" line44="                            if (parsed.a1 !== undefined) {" line45="                                this.latestLeftHand = &quot;&quot; + parsed.a1;" line46="                            }" line47="                            if (parsed.a2 !== undefined) {" line48="                                this.latestRightHand = &quot;&quot; + parsed.a2;" line49="                            }" line50="                        } else if (parsed.cmd === &quot;emotion_status&quot; &amp;&amp; parsed.emotion !== undefined) {" line51="                            this.latestEmotion = &quot;&quot; + parsed.emotion;" line52="                        } else if (parsed.cmd === &quot;volume_status&quot; &amp;&amp; parsed.volume !== undefined) {" line53="                            this.latestVolume = &quot;&quot; + parsed.volume;" line54="                        }" line55="                    } catch (e) {" line56="                    }" line57="                }" line58="            });" line59="" line60="            this.startKeepAlive();" line61="        }" line62="" line63="        public executeCommand(deviceName: string, payload: string, errorCode: number, executeTimeoutMs: number = 2000): boolean {" line64="            this.ensureInitialized();" line65="            this.latestAck = &quot;&quot;;" line66="            this.ackReceived = false;" line67="            this.ackSuccess = false;" line68="            this.expectedAckDevice = deviceName;" line69="            this.latestFinish = &quot;&quot;;" line70="            const ackTimeoutMs = 500;" line71="            const maxAttempts = 3;" line72="" line73="            for (let attempt = 0; attempt &lt; maxAttempts; attempt++) {" line74="                this.ackReceived = false;" line75="                this.ackSuccess = false;" line76="                this.latestAck = &quot;&quot;;" line77="                sendBoth(payload);" line78="" line79="                let ackStartTime = control.millis();" line80="                while (control.millis() - ackStartTime &lt; ackTimeoutMs) {" line81="                    if (this.ackReceived &amp;&amp; this.latestAck.includes(deviceName)) {" line82="                        break;" line83="                    }" line84="                    basic.pause(10);" line85="                }" line86="" line87="                if (this.ackReceived &amp;&amp; this.latestAck.includes(deviceName) &amp;&amp; this.ackSuccess) {" line88="                    break;" line89="                }" line90="            }" line91="" line92="            if (!(this.ackReceived &amp;&amp; this.latestAck.includes(deviceName) &amp;&amp; this.ackSuccess)) {" line93="                // ACK timeout: report the error, then return so the next block can run." line94="                this.showError(errorCode);" line95="                this.expectedAckDevice = &quot;&quot;;" line96="                return false;" line97="            }" line98="" line99="            // Finish checking logic commented out for bypass" line100="            /*" line101="            let finishSuccess = false;" line102="            let finishStartTime = control.millis();" line103="            while (control.millis() - finishStartTime &lt; executeTimeoutMs) {" line104="                if (this.latestFinish.includes(deviceName)) {" line105="                    if (this.latestFinish.includes(&quot;success&quot;)) {" line106="                        finishSuccess = true;" line107="                    }" line108="                    break;" line109="                }" line110="                basic.pause(10);" line111="            }" line112="" line113="            if (!finishSuccess) {" line114="                this.showError(errorCode);" line115="                return false;" line116="            }" line117="            */" line118="" line119="            this.expectedAckDevice = &quot;&quot;;" line120="            return true;" line121="        }" line122="" line123="        public requestStatus(): string {" line124="            this.ensureInitialized();" line125="            this.latestStatus = &quot;&quot;;" line126="            const payload = JSON.stringify({ cmd: &quot;get_status&quot; });" line127="            sendBoth(payload);" line128="" line129="            let startTime = control.millis();" line130="            while (this.latestStatus == &quot;&quot; &amp;&amp; control.millis() - startTime &lt; 2000) {" line131="                basic.pause(10);" line132="            }" line133="            return this.latestStatus;" line134="        }" line135="" line136="        public requestServoStatus(): void {" line137="            this.ensureInitialized();" line138="            this.latestLeftHand = &quot;&quot;;" line139="            this.latestRightHand = &quot;&quot;;" line140="            const payload2 = JSON.stringify({ cmd: &quot;get_servo&quot; });" line141="            sendBoth(payload2);" line142="" line143="            let startTime2 = control.millis();" line144="            while ((this.latestLeftHand == &quot;&quot; || this.latestRightHand == &quot;&quot;) &amp;&amp; control.millis() - startTime2 &lt; 2000) {" line145="                basic.pause(10);" line146="            }" line147="        }" line148="" line149="        public requestLeftHand(): string {" line150="            this.requestServoStatus();" line151="            return this.latestLeftHand;" line152="        }" line153="" line154="        public requestRightHand(): string {" line155="            this.requestServoStatus();" line156="            return this.latestRightHand;" line157="        }" line158="" line159="        public requestEmotion(): string {" line160="            this.ensureInitialized();" line161="            this.latestEmotion = &quot;&quot;;" line162="            const payload3 = JSON.stringify({ cmd: &quot;get_emotion&quot; });" line163="            sendBoth(payload3);" line164="" line165="            let startTime3 = control.millis();" line166="            while (this.latestEmotion == &quot;&quot; &amp;&amp; control.millis() - startTime3 &lt; 2000) {" line167="                basic.pause(10);" line168="            }" line169="            return this.latestEmotion;" line170="        }" line171="" line172="        public requestVolume(): string {" line173="            this.ensureInitialized();" line174="            this.latestVolume = &quot;&quot;;" line175="            const payload4 = JSON.stringify({ cmd: &quot;get_volume&quot; });" line176="            sendBoth(payload4);" line177="" line178="            let startTime4 = control.millis();" line179="            while (this.latestVolume == &quot;&quot; &amp;&amp; control.millis() - startTime4 &lt; 2000) {" line180="                basic.pause(10);" line181="            }" line182="            return this.latestVolume;" line183="        }" line184="" line185="        private showError(code: number): void {" line186="            basic.showNumber(code);" line187="            basic.pause(1000);" line188="            basic.clearScreen();" line189="        }" line190="" line191="        private sendMessage(text: string): void {" line192="            sendBoth(JSON.stringify({ MicroBit: text, checksum: checksum(text) }));" line193="        }" line194="" line195="        private startKeepAlive(): void {" line196="            const MIN_GAP_MS = 1000;" line197="            const MAX_GAP_MS = 5000;" line198="            control.inBackground(function () {" line199="                while (true) {" line200="                    link.sendMessage(&quot;Hello World!&quot;);" line201="                    basic.pause(Math.randomRange(MIN_GAP_MS, MAX_GAP_MS));" line202="                }" line203="            });" line204="        }" line205="    }" line206="" line207="    export const link = new R300Link();" line208="}" numlines="209"></mutation><next><block type="typescript_statement" id="nMR5fg+2Yuk;.V]0.3lz"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace r300_movement {" line1="    const CONTROL_MOTOR_MAX_TIME_MS = 5000;" line2="" line3="    export function controlMotor(rotation: number, forward: number, time: number): void {" line4="        rotation = clamp(Math.round(rotation), -100, 100);" line5="        forward = clamp(Math.round(forward), -100, 100);" line6="        time = clamp(Math.round(time), 0, CONTROL_MOTOR_MAX_TIME_MS);" line7="" line8="        const canonical = &quot;&quot; + rotation + &quot;,&quot; + forward + &quot;,&quot; + time;" line9="        const expected = checksum(canonical);" line10="" line11="        const payload5 = JSON.stringify({" line12="            cmd: &quot;set_control_motor&quot;," line13="            rotation: rotation," line14="            forward: forward," line15="            time: time," line16="            checksum: expected" line17="        });" line18="" line19="        r300.link.executeCommand(&quot;set_control_motor&quot;, payload5, 1, time + 2000);" line20="    }" line21="" line22="    //% block=&quot;drive %dir for %time seconds&quot;" line23="    //% time.defl=1" line24="    //% weight=90" line25="    //% group=&quot;Drive Control&quot;" line26="    export function drive(dir: MoveDirection, time: number = 1): void {" line27="        let timeMs = time * 1000;" line28="        if (dir === MoveDirection.Forward) {" line29="            controlMotor(0, 100, timeMs);" line30="        } else {" line31="            controlMotor(0, -100, timeMs);" line32="        }" line33="    }" line34="" line35="    //% block=&quot;turn %dir&quot;" line36="    //% weight=89" line37="    //% group=&quot;Turn Control&quot;" line38="    export function turn(dir: TurnDirection): void {" line39="        if (dir === TurnDirection.Left) {" line40="            controlMotor(-25, 0, 1000);" line41="        } else {" line42="            controlMotor(25, 0, 1000);" line43="        }" line44="    }" line45="" line46="    //% block=&quot;custom motor rotation %rotation forward %forward for %time ms&quot;" line47="    //% rotation.min=-100 rotation.max=100" line48="    //% forward.min=-100 forward.max=100" line49="    //% time.min=0 time.max=5000 time.defl=1000" line50="    //% weight=88" line51="    //% group=&quot;Custom Control&quot;" line52="    export function customMotor(rotation: number, forward: number, time: number): void {" line53="        controlMotor(rotation, forward, time);" line54="    }" line55="}" numlines="56"></mutation><next><block type="typescript_statement" id="[s?Tj}KHhttl8s4$!?|)"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace r300_hands {" line1="    export function controlServo(angle_1: number, angle_2: number, time: number): void {" line2="        angle_1 = clamp(Math.round(angle_1), -1, 180);" line3="        angle_2 = clamp(Math.round(angle_2), -1, 180);" line4="        time = -1;" line5="" line6="        const canonical2 = &quot;&quot; + angle_1 + &quot;,&quot; + angle_2 + &quot;,&quot; + time;" line7="        const expected2 = checksum(canonical2);" line8="" line9="        const payload6 = JSON.stringify({" line10="            cmd: &quot;set_control_servo&quot;," line11="            a1: angle_1," line12="            a2: angle_2," line13="            time: time," line14="            checksum: expected2" line15="        });" line16="" line17="        r300.link.executeCommand(&quot;set_control_servo&quot;, payload6, 2, 2000);" line18="    }" line19="" line20="    //% block=&quot;move left hand to %pos&quot;" line21="    //% pos.min=-1 pos.max=180" line22="    //% group=&quot;Hand Control&quot;" line23="    export function leftHand(pos: HandPosition): void {" line24="        controlServo(pos, -1, -1);" line25="    }" line26="" line27="    //% block=&quot;move right hand to %pos&quot;" line28="    //% pos.min=-1 pos.max=180" line29="    //% group=&quot;Hand Control&quot;" line30="    export function rightHand(pos: HandPosition): void {" line31="        controlServo(-1, pos, -1);" line32="    }" line33="" line34="    //% block=&quot;move both hands left %a1 right %a2&quot;" line35="    //% a1.min=-1 a1.max=180" line36="    //% a2.min=-1 a2.max=180" line37="    //% group=&quot;Hand Control&quot;" line38="    export function bothHands(a1: number, a2: number): void {" line39="        controlServo(a1, a2, -1);" line40="    }" line41="" line42="    //% block=&quot;get left hand position&quot;" line43="    //% group=&quot;Hand Status&quot;" line44="    export function getLeftHand(): string {" line45="        return r300.link.requestLeftHand();" line46="    }" line47="" line48="    //% block=&quot;get right hand position&quot;" line49="    //% group=&quot;Hand Status&quot;" line50="    export function getRightHand(): string {" line51="        return r300.link.requestRightHand();" line52="    }" line53="}" numlines="54"></mutation><next><block type="typescript_statement" id="pzGSI[v4MsP?u_iNIF)T"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace r300_api {" line1="    let api1Handler: () =&gt; void = null;" line2="    let api2Handler: () =&gt; void = null;" line3="    let api3Handler: () =&gt; void = null;" line4="    let api4Handler: () =&gt; void = null;" line5="    let api5Handler: () =&gt; void = null;" line6="" line7="    export function dispatchApi(cmd: string): void {" line8="        if (cmd.includes(&quot;cmd_api_1&quot;) &amp;&amp; api1Handler) {" line9="            control.inBackground(api1Handler);" line10="        } else if (cmd.includes(&quot;cmd_api_2&quot;) &amp;&amp; api2Handler) {" line11="            control.inBackground(api2Handler);" line12="        } else if (cmd.includes(&quot;cmd_api_3&quot;) &amp;&amp; api3Handler) {" line13="            control.inBackground(api3Handler);" line14="        } else if (cmd.includes(&quot;cmd_api_4&quot;) &amp;&amp; api4Handler) {" line15="            control.inBackground(api4Handler);" line16="        } else if (cmd.includes(&quot;cmd_api_5&quot;) &amp;&amp; api5Handler) {" line17="            control.inBackground(api5Handler);" line18="        }" line19="    }" line20="" line21="    //% block=&quot;program 1&quot;" line22="    //% group=&quot;API Program 1&quot;" line23="    export function program1(handler: () =&gt; void): void {" line24="        api1Handler = handler;" line25="    }" line26="" line27="    //% block=&quot;program 2&quot;" line28="    //% group=&quot;API Program 2&quot;" line29="    export function program2(handler: () =&gt; void): void {" line30="        api2Handler = handler;" line31="    }" line32="" line33="    //% block=&quot;program 3&quot;" line34="    //% group=&quot;API Program 3&quot;" line35="    export function program3(handler: () =&gt; void): void {" line36="        api3Handler = handler;" line37="    }" line38="" line39="    //% block=&quot;program 4&quot;" line40="    //% group=&quot;API Program 4&quot;" line41="    export function program4(handler: () =&gt; void): void {" line42="        api4Handler = handler;" line43="    }" line44="" line45="    //% block=&quot;program 5&quot;" line46="    //% group=&quot;API Program 5&quot;" line47="    export function program5(handler: () =&gt; void): void {" line48="        api5Handler = handler;" line49="    }" line50="}" numlines="51"></mutation><next><block type="typescript_statement" id="2D7:1Te0z:GhH5gpwGs-"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace r300_emotion {" line1="    //% block=&quot;show emotion %face&quot;" line2="    //% group=&quot;Emotion Control&quot;" line3="    export function showEmotion(face: RobotEmotion): void {" line4="        const payload7 = JSON.stringify({" line5="            cmd: &quot;set_emotion&quot;," line6="            emotion: face" line7="        });" line8="        r300.link.executeCommand(&quot;set_emotion&quot;, payload7, 3, 2000);" line9="    }" line10="" line11="    //% block=&quot;get current emotion&quot;" line12="    //% group=&quot;Emotion Status&quot;" line13="    export function getEmotion(): string {" line14="        return r300.link.requestEmotion();" line15="    }" line16="}" numlines="17"></mutation><next><block type="typescript_statement" id="^R}ButBD}fX5er9y=ujt"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace r300_speaker {" line1="    //% block=&quot;speak text %text&quot;" line2="    //% group=&quot;Audio Actions&quot;" line3="    export function speakText(text: string): void {" line4="        const payload8 = JSON.stringify({" line5="            cmd: &quot;set_speak&quot;," line6="            message: text" line7="        });" line8="        const timeoutMs = text.length * 100 + 2000;" line9="        r300.link.executeCommand(&quot;set_speak&quot;, payload8, 4, timeoutMs);" line10="    }" line11="" line12="    //% block=&quot;set speaker volume to %volume&quot;" line13="    //% volume.min=0 volume.max=100" line14="    //% group=&quot;Audio Actions&quot;" line15="    export function setSpeakerVol(volume: number): void {" line16="        volume = clamp(Math.round(volume), 0, 100);" line17="        const payload9 = JSON.stringify({" line18="            cmd: &quot;set_volume&quot;," line19="            volume: volume" line20="        });" line21="        r300.link.executeCommand(&quot;set_volume&quot;, payload9, 5, 2000);" line22="    }" line23="" line24="    //% block=&quot;get speaker volume&quot;" line25="    //% group=&quot;Speaker Status&quot;" line26="    export function getSpeakerVol(): string {" line27="        return r300.link.requestVolume();" line28="    }" line29="}" numlines="30"></mutation><next><block type="typescript_statement" id="Ok35VCh%^cnnI9GU^OUP"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace r300_mode {" line1="    //% block=&quot;set robot mode to %mode&quot;" line2="    //% group=&quot;Configuration&quot;" line3="    export function setRobotMode(mode: RobotMode): void {" line4="        const payload10 = JSON.stringify({" line5="            cmd: &quot;set_mode&quot;," line6="            mode: mode" line7="        });" line8="        r300.link.executeCommand(&quot;set_mode&quot;, payload10, 6, 2000);" line9="    }" line10="" line11="    //% block=&quot;bypass mode %bypass&quot;" line12="    //% group=&quot;Configuration&quot;" line13="    export function bypassMode(bypass: boolean): void {" line14="        const payload11 = JSON.stringify({" line15="            cmd: &quot;set_bypass_mode&quot;," line16="            bypass: bypass" line17="        });" line18="        r300.link.executeCommand(&quot;set_bypass_mode&quot;, payload11, 7, 2000);" line19="    }" line20="" line21="    //% block=&quot;get robot status&quot;" line22="    //% group=&quot;System Status&quot;" line23="    export function getStatus(): string {" line24="        return r300.link.requestStatus();" line25="    }" line26="}" numlines="27"></mutation><next><block type="typescript_statement" id="M?;l+3/X7%@5|~|SX[TH"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum MoveDirection {" line1="    //% block=&quot;forward&quot;" line2="    Forward," line3="    //% block=&quot;backward&quot;" line4="    Backward" line5="}" numlines="6"></mutation><next><block type="typescript_statement" id="]g=[BJ.s?DT