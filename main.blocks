<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="xRRgvHNlG#rZ^u`HECiY" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="6S/QaE6QOz5vkKtvv*o{"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum ApiCommand {" line1="    //% block=&quot;Get Status&quot;" line2="    GetStatus," line3="    //% block=&quot;Set Sensor Mode&quot;" line4="    SetSensorMode," line5="    //% block=&quot;Reset Board&quot;" line6="    ResetBoard" line7="}" numlines="8"></mutation><next><block type="typescript_statement" id=",W7i[3L,418)o8Z~D-;h"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace R300ApiTx {" line1="    let pendingReqId = -1;" line2="    let ackReceived = false;" line3="    let listenerInitialized = false;" line4="" line5="    /**" line6="     * Initializes the UART listener to process incoming ACK packets." line7="     * Expected ACK format: {&quot;ack&quot;: timestamp, &quot;status&quot;: &quot;ok&quot;}" line8="     */" line9="    function initAckListener() {" line10="        if (listenerInitialized) return;" line11="        listenerInitialized = true;" line12="" line13="        serial.onDataReceived(serial.delimiters(Delimiters.NewLine), () =&gt; {" line14="            let line = serial.readLine();" line15="            try {" line16="                let msg = JSON.parse(line);" line17="                if (msg &amp;&amp; msg.ack === pendingReqId) {" line18="                    ackReceived = true;" line19="                }" line20="            } catch (e) {" line21="                // Ignore malformed or non-JSON serial input" line22="            }" line23="        });" line24="    }" line25="" line26="    /**" line27="     * Calculates a simple 16-bit Fletcher checksum for a string." line28="     */" line29="    function calculateChecksum(data: string): number {" line30="        let sum1 = 0;" line31="        let sum2 = 0;" line32="        for (let i = 0; i &lt; data.length; i++) {" line33="            sum1 = (sum1 + data.charCodeAt(i)) % 255;" line34="            sum2 = (sum2 + sum1) % 255;" line35="        }" line36="        return (sum2 &lt;&lt; 8) | sum1;" line37="    }" line38="" line39="    /**" line40="     * Send standardized API payload over UART with ACK wait &amp; retry logic." line41="     * Shows LED status indicators on success (Checkmark) or failure (X for 5s)." line42="     * @param cmd API Command to execute" line43="     * @param maxRetries Maximum retry attempts (default 3)" line44="     * @param timeoutMs Timeout in ms per attempt (default 500ms)" line45="     */" line46="    //% block=&quot;send API command %cmd over UART&quot;" line47="    //% cmd.fieldEditor=&quot;gridpicker&quot;" line48="    //% cmd.fieldOptions.columns=3" line49="    export function sendApiPayload(cmd: ApiCommand, maxRetries: number = 3, timeoutMs: number = 500): void {" line50="        initAckListener();" line51="" line52="        let actionStr = &quot;&quot;;" line53="        let actionData: any = {};" line54="        let ts = input.runningTime(); // Timestamp serves as the unique request ID" line55="" line56="        switch (cmd) {" line57="            case ApiCommand.GetStatus:" line58="                actionStr = &quot;getStatus&quot;;" line59="                actionData = { reqId: ts };" line60="                break;" line61="            case ApiCommand.SetSensorMode:" line62="                actionStr = &quot;setMode&quot;;" line63="                actionData = { reqId: ts, mode: &quot;active&quot;, rate: 500 };" line64="                break;" line65="            case ApiCommand.ResetBoard:" line66="                actionStr = &quot;reset&quot;;" line67="                actionData = { reqId: ts, hard: true };" line68="                break;" line69="        }" line70="" line71="        let payload = {" line72="            ts: ts," line73="            action: actionStr," line74="            data: actionData" line75="        };" line76="" line77="        let jsonString = JSON.stringify(payload);" line78="        let chk = calculateChecksum(jsonString);" line79="" line80="        let framedMessage = JSON.stringify({" line81="            raw: jsonString," line82="            chk: chk" line83="        });" line84="" line85="        // Retry loop" line86="        for (let attempt = 0; attempt &lt; maxRetries; attempt++) {" line87="            pendingReqId = ts;" line88="            ackReceived = false;" line89="" line90="            serial.writeLine(framedMessage);" line91="" line92="            // Wait for ACK or timeout" line93="            let startTime = input.runningTime();" line94="            while (input.runningTime() - startTime &lt; timeoutMs) {" line95="                if (ackReceived) {" line96="                    pendingReqId = -1;" line97="" line98="                    // Debug Visual: Brief checkmark for success" line99="                    basic.showIcon(IconNames.Yes);" line100="                    basic.pause(300);" line101="                    basic.clearScreen();" line102="" line103="                    return;" line104="                }" line105="                basic.pause(20); // Yield to MakeCode event queue" line106="            }" line107="        }" line108="" line109="        // Execution failed after all retry attempts" line110="        pendingReqId = -1;" line111="" line112="        // Debug Visual: Show 'X' for 5 seconds on failure" line113="        basic.showIcon(IconNames.No);" line114="        basic.pause(5000);" line115="        basic.clearScreen();" line116="" line117="        // return false;" line118="    }" line119="}" numlines="120"></mutation></block></next></block></statement></block></xml>